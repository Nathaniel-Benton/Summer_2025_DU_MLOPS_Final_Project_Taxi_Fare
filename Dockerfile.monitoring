FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY monitoring_dashboard.py .

EXPOSE 8502

# This app talks directly to DynamoDB, not to the backend — it needs its
# own AWS credentials at runtime, same pattern as the backend:
#   docker run -p 8502:8502 \
#     -e AWS_ACCESS_KEY_ID=... \
#     -e AWS_SECRET_ACCESS_KEY=... \
#     -e AWS_SESSION_TOKEN=... \
#     -e AWS_DEFAULT_REGION=us-east-1 \
#     taxi-fare-monitoring
CMD ["streamlit", "run", "monitoring_dashboard.py", "--server.port=8502", "--server.address=0.0.0.0"]